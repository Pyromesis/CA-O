<Page
    x:Class="CAO.UI.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Benchmark" FontSize="28" FontWeight="SemiBold" />
            <InfoBar IsOpen="True" Severity="Informational"
                     Title="Metodología"
                     Message="Cargas fijas y reproducibles (CPU/memoria/disco). El veredicto usa un suelo de ruido del 3%: sin diferencia medible, el cambio no se mantiene." />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BaselineButton" Click="OnBaselineClick" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="AfterButton" Click="OnAfterClick" />
                <ProgressRing x:Name="Ring" IsActive="False" Width="26" Height="26" />
            </StackPanel>
            <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Opacity="0.9" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="ComparisonText" TextWrapping="Wrap" Opacity="0.9" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
