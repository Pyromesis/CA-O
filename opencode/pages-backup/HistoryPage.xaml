<Page
    x:Class="CAO.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Historial" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceNote" Opacity="0.65" TextWrapping="Wrap" />
            <Button Content="Actualizar" Click="OnRefreshClick" />
            <ListView x:Name="HistoryList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding Operation}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OptimizationId}" FontSize="12" />
                                    <TextBlock Text="{Binding OutcomeLabel}" FontSize="12"
                                               Foreground="{Binding OutcomeBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
