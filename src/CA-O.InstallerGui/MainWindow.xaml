<Window
    x:Class="CAO.InstallerGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CA-O 2.0 Setup">
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="CA-O 2.0 Setup" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Plataforma de optimización para Windows 11" FontSize="14" Opacity="0.7" HorizontalAlignment="Center"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Destino de instalación" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DestinationPathText" Text="C:\Program Files\CA-O" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="Se instalará el servicio CAO.Privileged y accesos directos." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <CheckBox x:Name="DesktopShortcutCheck" Content="Crear acceso directo en el escritorio" IsChecked="True"/>
                <CheckBox x:Name="StartMenuShortcutCheck" Content="Crear acceso en el Menú Inicio" IsChecked="True"/>
                <CheckBox x:Name="AutoLaunchCheck" Content="Iniciar CA-O después de la instalación" IsChecked="True"/>
            </StackPanel>
            <Border x:Name="ProgressCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Progreso" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="ProgressBar" Value="0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStatusText" Text="Iniciando..."/>
                    <TextBlock x:Name="ProgressDetailText" Text="" FontSize="12" Opacity="0.6" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border x:Name="LogCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Height="160">
                <ScrollViewer>
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"/>
                </ScrollViewer>
            </Border>
            <InfoBar x:Name="InfoBar" Title="Instalador CA-O 2.0" Message="Se instalará en C:\Program Files\CA-O. Requiere permisos de administrador." Severity="Informational" IsOpen="True" IsClosable="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="CancelButton" Content="Cancelar" Width="120" IsEnabled="False" Click="OnCancelClick"/>
                <Button x:Name="InstallButton" Content="Instalar" Width="160" Style="{StaticResource AccentButtonStyle}" Click="OnInstallClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
