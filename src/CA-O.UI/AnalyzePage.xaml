<Page
    x:Class="CAO.UI.Pages.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Responsive">
                <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000"/></VisualState.StateTriggers></VisualState>
                <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="CardsGrid.ColumnDefinitions[1].Width" Value="0"/></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="Analizar sistema" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Escaneo completo: CPU, GPU, memoria, disco, velocidades, red, seguridad, drivers, térmica e input. Nada aquí modifica el sistema." FontSize="13" Opacity="0.6" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RunButton" Content="Ejecutar análisis completo" Click="OnRunClick" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Ejecutar análisis completo"/>
                <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancelClick" Visibility="Collapsed"
                        AutomationProperties.Name="Cancelar análisis"/>
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22"/>
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>

            <InfoBar x:Name="NoteBar" IsOpen="True" Severity="Informational"
                     Title="Diagnósticos primero"
                     Message="Cada área se mide antes de recomendar cualquier cambio. Nada aquí modifica el sistema."
                     IsClosable="False"/>

            <!-- Progress tracker (Fase 57) -->
            <Border x:Name="ProgressCard" Style="{StaticResource CaoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Progreso del análisis" FontWeight="SemiBold" FontSize="13"/>
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU" Grid.Row="0" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="CpuRing" Grid.Row="0" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="GPU" Grid.Row="1" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="GpuRing" Grid.Row="1" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="Memoria" Grid.Row="2" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="MemRing" Grid.Row="2" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="Almacenamiento" Grid.Row="3" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="StorRing" Grid.Row="3" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="Red" Grid.Row="4" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="NetRing" Grid.Row="4" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="Seguridad" Grid.Row="5" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="SecRing" Grid.Row="5" Grid.Column="2" Width="14" Height="14"/>
                        <TextBlock Text="Drivers" Grid.Row="6" Grid.Column="0" FontSize="12"/><ProgressRing x:Name="DrvRing" Grid.Row="6" Grid.Column="2" Width="14" Height="14"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="14"/>
                            <TextBlock Text="CPU" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="CpuText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9" Text="Ejecuta análisis para medir CPU"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14"/>
                            <TextBlock Text="GPU" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="GpuText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9" Text="Ejecuta análisis para medir GPU"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BE;" FontSize="14"/>
                            <TextBlock Text="Memoria" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="MemoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9" Text="Ejecuta análisis para medir RAM"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="14"/>
                            <TextBlock Text="Red" FontWeight="SemiBold"/>
                            <Border x:Name="NetStatusBadge" Style="{StaticResource CaoBadgeStyle}" Visibility="Collapsed"><TextBlock x:Name="NetStatusText" FontSize="11"/></Border>
                        </StackPanel>
                        <TextBlock x:Name="NetworkText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                        <Button x:Name="DnsActionButton" Content="Aplicar mejor DNS detectado" Click="OnDnsBenchClick" FontSize="12" ToolTipService.ToolTip="Ejecuta benchmark y aplica el DNS más rápido via netsh (requiere servicio)"/>
                        <TextBlock x:Name="DnsBestText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="14"/>
                            <TextBlock Text="Seguridad" FontWeight="SemiBold"/>
                            <Border x:Name="SecStatusBadge" Style="{StaticResource CaoBadgeStyle}" Visibility="Collapsed"><TextBlock x:Name="SecStatusText" FontSize="11"/></Border>
                        </StackPanel>
                        <TextBlock x:Name="SecurityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="14"/>
                            <TextBlock Text="Almacenamiento" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StorageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE964;" FontSize="14"/>
                            <TextBlock Text="Drivers" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Lista drivers con código de problema, sin firma o detenidos. Si no detecta nada, no hay problemas." FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DriversText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D2;" FontSize="14"/>
                            <TextBlock Text="Latencia DPC/ISR" FontWeight="SemiBold"/>
                            <TextBlock Text="Mide % Tiempo DPC e Interrupción. Alto = audio entrecortado, micro-stutter, input lag. Se auto-ejecuta con el análisis." FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Muestrear 5 s" Click="OnDpcSampleClick" FontSize="12" ToolTipService.ToolTip="Mide 5s % DPC Time / % Interrupt Time via contadores. No atribuye driver sin ETW"/>
                            <ProgressRing x:Name="DpcRing" Width="16" Height="16" IsActive="False"/>
                            <TextBlock x:Name="DpcStatusText" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="InterruptsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7FC;" FontSize="14"/>
                        <TextBlock Text="Gaming — optimizaciones bloqueadas" FontWeight="SemiBold"/>
                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Anti-cheat detectado bloquea cambios que reducen seguridad. Con candado en Optimizar." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GamingBlockedText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9" Text="Ejecuta análisis para detectar anti-cheat y juegos"/>
                    <TextBlock x:Name="GamingGamesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Opacity="0.7"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
