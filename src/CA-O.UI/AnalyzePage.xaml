<Page
    x:Class="CAO.UI.Pages.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Responsive">
                <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000"/></VisualState.StateTriggers></VisualState>
                <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HardwareGrid.RowSpacing" Value="12"/>
                        <Setter Target="StatusText.FontSize" Value="12"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Analizar sistema" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Escaneo completo: CPU, GPU, memoria, disco, velocidades, red, seguridad, drivers, térmica e input. Nada aquí modifica el sistema." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>

            <Border Style="{StaticResource CaoActionCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CaoIconCircleStyle}" Background="{StaticResource CaoBlueSoftBrush}" Width="44" Height="44">
                        <FontIcon Glyph="&#xE71E;" FontSize="19" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Diagnóstico con evidencia" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75" FontWeight="Medium" AutomationProperties.LiveSetting="Polite" Text="Listo para medir tu sistema"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="RunButton" Content="Ejecutar análisis completo" Click="OnRunClick" Style="{StaticResource CaoGradientButtonStyle}"
                                AutomationProperties.Name="Ejecutar análisis completo"/>
                        <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancelClick" Visibility="Collapsed"
                                AutomationProperties.Name="Cancelar análisis" Style="{StaticResource CaoElevatedButtonStyle}"/>
                        <Button Content="Muestrear DPC/ISR" Click="OnDpcSampleClick" FontSize="12" Style="{StaticResource CaoElevatedButtonStyle}"
                                AutomationProperties.Name="Muestrear latencia DPC ISR" ToolTipService.ToolTip="Mide 5 s de presión DPC/ISR"/>
                        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" Style="{StaticResource CaoProgressRingStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado: banda fina con veredicto, puntuaciones y desglose -->
            <Border Style="{StaticResource CaoCardStyle}" Padding="12,10,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border x:Name="SystemHealthBadge" Style="{StaticResource CaoStatusIndicatorStyle}" Background="{ThemeResource SystemFillColorNeutralBrush}">
                        <TextBlock x:Name="SystemHealthText" Text="Sistema: —" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="HealthScoresText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontWeight="Medium"/>
                    </StackPanel>
                    <HyperlinkButton x:Name="WhyScoresButton" Content="Desglose" FontSize="12" Click="OnWhyScoresClick" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- (Hallazgos movidos al final, tras Gaming) -->
            <InfoBar x:Name="NoteBar" IsOpen="True" Severity="Informational"
                     Title="Diagnósticos primero"
                     Message="Cada área se mide antes de recomendar cualquier cambio. Nada aquí modifica el sistema."
                     IsClosable="False"/>

            <!-- Cómo funciona (solo antes del primer análisis) -->
            <Border x:Name="HowItWorksCard" Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cómo funciona" FontWeight="SemiBold" FontSize="14"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource CaoStepCircleStyle}"><TextBlock Text="1" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Mide" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Análisis en ~30 s. No modifica nada." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource CaoStepCircleStyle}"><TextBlock Text="2" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Revisa" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Hallazgos con severidad y detalle." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource CaoStepCircleStyle}"><TextBlock Text="3" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Actúa" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Aplica en Optimizar o Limpieza." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Button Content="Ejecutar análisis ahora" Click="OnRunClick" Style="{StaticResource CaoAccentButtonStyle}" HorizontalAlignment="Center" AutomationProperties.Name="Ejecutar análisis ahora"/>
                </StackPanel>
            </Border>

            <!-- Resultados (solo con análisis vigente o en curso) -->
            <StackPanel x:Name="ResultsContent" Spacing="20" Visibility="Collapsed">

            <!-- Detalle medido por área -->
            <TextBlock Text="Detalle medido por área" Style="{StaticResource CaoSectionTitleStyle}"/>

            <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CardNetwork" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoCyanSoftBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource CaoCyanSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Red" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Latencia, jitter y DNS" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                            <Border x:Name="NetStatusBadge" Style="{StaticResource CaoBadgeStyle}" Visibility="Collapsed"><TextBlock x:Name="NetStatusText" FontSize="11"/></Border>
                        </StackPanel>
                        <TextBlock x:Name="NetworkText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                        <StackPanel x:Name="DnsBarsPanel" Spacing="6" Margin="0,4,0,0"/>
                        <Button x:Name="DnsActionButton" Content="Aplicar mejor DNS detectado" Click="OnDnsBenchClick" FontSize="12" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Aplicar mejor DNS detectado" ToolTipService.ToolTip="Ejecuta benchmark y aplica el DNS más rápido via netsh (requiere servicio)"/>
                        <TextBlock x:Name="DnsBestText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardSecurity" Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Seguridad" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Secure Boot, VBS y anti-cheat" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                            <Border x:Name="SecStatusBadge" Style="{StaticResource CaoBadgeStyle}" Visibility="Collapsed"><TextBlock x:Name="SecStatusText" FontSize="11"/></Border>
                        </StackPanel>
                        <TextBlock x:Name="SecurityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CardStorage" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                                <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Almacenamiento" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Volúmenes y espacio libre" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="StorageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                        <StackPanel x:Name="StorageBarsPanel" Spacing="8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardDrivers" Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoPurpleSoftBrush}">
                                <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Drivers" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Problemas, firmas y estado" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Lista drivers con código de problema, sin firma o detenidos. Si no detecta nada, no hay problemas." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DriversText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Latencia y respuesta -->
            <TextBlock Text="Latencia y respuesta" Style="{StaticResource CaoSectionTitleStyle}"/>

            <!-- Diagnóstico integrado (reutiliza mismos providers que DiagnosticsPage, sin duplicar lógica) -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CardInput" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoCyanSoftBrush}">
                                <FontIcon Glyph="&#xE8B0;" FontSize="16" Foreground="{StaticResource CaoCyanSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Entrada" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Ratón e HID" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="DiagnInputText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardThermal" Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                                <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Térmico" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Zonas ACPI y throttling" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="DiagnThermalText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="CardPerf" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoGreenSoftBrush}">
                                <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Rendimiento actual" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Carga de CPU en vivo" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="DiagnPerfText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoRoseSoftBrush}">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource CaoRoseSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Latencia DPC/ISR" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="% DPC e interrupción · 5 s" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Alto = audio entrecortado, micro-stutter, input lag. Se auto-ejecuta con el análisis." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Muestrear 5 s" Click="OnDpcSampleClick" FontSize="12" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Muestrear latencia DPC 5 segundos" ToolTipService.ToolTip="Mide 5s % DPC Time / % Interrupt Time via contadores. No atribuye driver sin ETW"/>
                            <ProgressRing x:Name="DpcRing" Width="16" Height="16" IsActive="False" Style="{StaticResource CaoProgressRingStyle}"/>
                            <TextBlock x:Name="DpcStatusText" FontSize="11" Opacity="0.7" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <TextBlock x:Name="InterruptsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <!-- Gaming y anti-cheat -->
            <TextBlock Text="Gaming y anti-cheat" Style="{StaticResource CaoSectionTitleStyle}"/>

            <Border x:Name="CardGaming" Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoPurpleSoftBrush}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Optimizaciones bloqueadas" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Candado en Optimizar" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Anti-cheat detectado bloquea cambios que reducen seguridad. Con candado en Optimizar." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GamingBlockedText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    <TextBlock x:Name="GamingGamesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Opacity="0.7"/>
                    <TextBlock x:Name="GamingScanText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="11" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- Hallazgos del diagnóstico (al final) -->
            <StackPanel Spacing="2" Margin="0,8,0,0">
                <TextBlock x:Name="FindingsHeader" Text="Hallazgos del diagnóstico" Style="{StaticResource CaoSectionTitleStyle}"/>
                <TextBlock x:Name="FindingsCountText" Text="Cada hallazgo sale de una medición real con su severidad." Style="{StaticResource CaoSectionSubtitleStyle}"/>
            </StackPanel>
            <Border x:Name="EmptyFindingsState" Style="{StaticResource CaoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="6" HorizontalAlignment="Center" Padding="12">
                    <FontIcon Glyph="&#xE930;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin hallazgos" Style="{StaticResource CaoEmptyStateTitleStyle}"/>
                    <TextBlock Text="No se detectaron problemas. Ejecute un análisis completo para refrescar." FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <ListView x:Name="FindingsList" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" CornerRadius="{StaticResource CaoRadiusSmall}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,3">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="4" CornerRadius="2" Background="{Binding SeverityBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="11" Opacity="0.65" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MessageEs}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Pie: resumen del último análisis -->
            <Border Style="{StaticResource CaoCardStyle}" Padding="12,10,12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{StaticResource CaoOpsCyanBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AnalysisFooterText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
