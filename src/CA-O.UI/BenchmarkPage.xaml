<Page
    x:Class="CAO.UI.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <TextBlock Text="Benchmark" Style="{StaticResource CaoPageTitleStyle}"/>
            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                     Title="Metodología honesta"
                     Message="Cargas fijas y reproducibles (CPU/memoria/disco). Veredicto con suelo de ruido 3%: sin diferencia medible no hay mejora. El benchmark nunca muta el estado transaccional."/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BaselineButton" Content="Medir línea base" Click="OnBaselineClick" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="AfterButton" Content="Medir tras cambio" Click="OnAfterClick"/>
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22"/>
                <TextBlock x:Name="BenchStatusText" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Flujo guiado: Paso 1 Crear línea base → Paso 2 Aplicar optimización → Paso 3 Medir después → Paso 4 Comparar → Paso 5 Veredicto" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed" x:Name="StepCard">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CurrentStepText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="VerdictText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Línea base" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Opacity="0.9" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Comparación A/B" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="ComparisonText" TextWrapping="Wrap" Opacity="0.9" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="El benchmark no modifica snapshots ni historial; solo mide." FontSize="11" Opacity="0.5"/>
        </StackPanel>
    </ScrollViewer>
</Page>
