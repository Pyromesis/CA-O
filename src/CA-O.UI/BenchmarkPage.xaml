<Page
    x:Class="CAO.UI.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="Benchmark" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Metodología honesta: cargas fijas y reproducibles (CPU/memoria/disco). Veredicto con suelo de ruido 3%." Style="{StaticResource CaoSubtitleStyle}"/>
            </StackPanel>
            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                     Title="Metodología honesta"
                     Message="Cargas fijas y reproducibles (CPU/memoria/disco). Veredicto con suelo de ruido 3%: sin diferencia medible no hay mejora. El benchmark nunca muta el estado transaccional."/>
            
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Flujo de benchmark" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="1. Crear línea base de referencia" FontSize="12" Opacity="0.85" Margin="0,2,0,0"/>
                    <TextBlock Text="2. Aplicar optimización (con snapshot)" FontSize="12" Opacity="0.85"/>
                    <TextBlock Text="3. Medir después con cargas idénticas" FontSize="12" Opacity="0.85"/>
                    <TextBlock Text="4. Comparar resultados con intervalo de confianza" FontSize="12" Opacity="0.85"/>
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button x:Name="BaselineButton" Content="Medir línea base" Click="OnBaselineClick" Style="{StaticResource CaoAccentButtonStyle}"/>
                <Button x:Name="AfterButton" Content="Medir tras cambio" Click="OnAfterClick" Style="{StaticResource CaoElevatedButtonStyle}"/>
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" Style="{StaticResource CaoProgressRingStyle}"/>
                <TextBlock x:Name="BenchStatusText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" FontWeight="Medium"/>
            </StackPanel>
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed" x:Name="StepCard">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CurrentStepText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4"/>
                    <TextBlock x:Name="VerdictText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.9"/>
                </StackPanel>
            </Border>
            
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F8;" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="Línea base" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.3"/>
                        <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D1;" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="Comparación A/B" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.3"/>
                        <TextBlock x:Name="ComparisonText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Nota: El benchmark no modifica snapshots ni historial; solo mide rendimiento sin efectos secundarios." FontSize="10" Opacity="0.6" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
