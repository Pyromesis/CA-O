<Page
    x:Class="CAO.UI.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:CAO.UI.Helpers"
    xmlns:controls="using:CAO.UI.Controls">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="PageContent" Style="{StaticResource CaoPageContainerStyle}">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Benchmark" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Metodología honesta: cargas fijas y reproducibles (CPU/memoria/disco). Veredicto con suelo de ruido 3%." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>
            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                     Title="Metodología honesta"
                     Message="3 trials con warmup y mediana: un pico aislado no fabrica mejoras. Suelo de ruido 3%: sin diferencia medible no hay mejora. El benchmark nunca muta el estado transaccional."/>

            <Border x:Name="OptContextCard" Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed" helpers:UiAnimations.CardHover="True">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CtxOptText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="ClearContextButton" Content="Limpiar contexto" Click="OnClearContextClick" Style="{StaticResource CaoElevatedButtonStyle}" FontSize="11" AutomationProperties.Name="Limpiar contexto de benchmark"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Qué mide (y para qué sirve)" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="CPU, memoria y disco reales para validar cambios" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CaoBlueSoftBrush}" CornerRadius="8" Padding="10" helpers:UiAnimations.CardHover="True">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="CPU" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="Primos fijos" FontSize="10" Opacity="0.7" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource CaoGreenSoftBrush}" CornerRadius="8" Padding="10" helpers:UiAnimations.CardHover="True">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEB4B;" FontSize="18" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Memoria" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="GB/s copia" FontSize="10" Opacity="0.7" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource CaoCyanSoftBrush}" CornerRadius="8" Padding="10" helpers:UiAnimations.CardHover="True">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{StaticResource CaoCyanSolidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Disco" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="R/W MB/s" FontSize="10" Opacity="0.7" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{StaticResource CaoPurpleSoftBrush}" CornerRadius="8" Padding="10" helpers:UiAnimations.CardHover="True">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE930;" FontSize="18" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Regla 3%" FontWeight="Bold" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="Sin humo" FontSize="10" Opacity="0.7" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ContextText" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Text="Conecte el cargador y cierre apps pesadas antes de medir."/>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoPurpleSoftBrush}">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Flujo de benchmark" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="4 pasos guiados y reproducibles" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CaoStepCircleStyle}" HorizontalAlignment="Center"><TextBlock Text="1" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Línea base" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CaoStepCircleStyle}" HorizontalAlignment="Center"><TextBlock Text="2" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Aplicar cambio" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CaoStepCircleStyle}" HorizontalAlignment="Center"><TextBlock Text="3" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Medir después" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CaoStepCircleStyle}" HorizontalAlignment="Center"><TextBlock Text="4" Foreground="{StaticResource CaoOpsCyanBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Comparar" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource CaoActionCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:CaoCat x:Name="BenchCat" Width="64" Height="76" VerticalAlignment="Center"
                                     AutomationProperties.Name="Mascota de CA-O"/>
                    <Border Grid.Column="1" Style="{StaticResource CaoIconCircleStyle}" Background="{StaticResource CaoBlueSoftBrush}" Width="44" Height="44">
                        <FontIcon Glyph="&#xE7F8;" FontSize="19" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Medición A/B" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="BenchStatusText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" FontWeight="Medium" AutomationProperties.LiveSetting="Polite" Text="Cargas idénticas antes y después"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BaselineButton" Content="Medir línea base" Click="OnBaselineClick" Style="{StaticResource CaoGradientButtonStyle}" AutomationProperties.Name="Medir línea base"/>
                        <Button x:Name="AfterButton" Content="Medir tras cambio" Click="OnAfterClick" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Medir tras cambio"/>
                        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" Style="{StaticResource CaoProgressRingStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed" x:Name="StepCard" helpers:UiAnimations.CardHover="True">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CurrentStepText" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4"/>
                    <TextBlock x:Name="VerdictText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.9"/>
                </StackPanel>
            </Border>
            
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="DnsCard" Style="{StaticResource CaoCardStyle}" helpers:UiAnimations.CardHover="True">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoCyanSoftBrush}">
                                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource CaoCyanSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DnsTitleText" Text="DNS real" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Latencia medida, no impuesta" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource CaoDividerStyle}"/>
                        <Button x:Name="DnsButton" Content="Medir DNS" Click="OnDnsClick" Style="{StaticResource CaoElevatedButtonStyle}" FontSize="12" AutomationProperties.Name="Medir DNS"/>
                        <TextBlock x:Name="DnsResultText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                        <StackPanel x:Name="DnsBarsPanel" Spacing="6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" x:Name="BootCard" Style="{StaticResource CaoCardStyle}" helpers:UiAnimations.CardHover="True">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="BootTitleText" Text="Arranque" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Último arranque del sistema" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource CaoDividerStyle}"/>
                        <TextBlock x:Name="BootText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="FluencyCard" Style="{StaticResource CaoCardStyle}" helpers:UiAnimations.CardHover="True">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoPurpleSoftBrush}">
                            <FontIcon Glyph="&#xE7F3;" FontSize="16" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="FluencyTitleText" Text="Fluidez gaming (10 s)" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="avgFPS · 1% low · P99 · DPC" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="FluencyButton" Content="Medir fluidez 10 s" Click="OnFluencyClick" Style="{StaticResource CaoElevatedButtonStyle}" FontSize="12" AutomationProperties.Name="Medir fluidez 10 segundos"/>
                        <ProgressRing x:Name="FluencyRing" IsActive="False" Width="18" Height="18" Style="{StaticResource CaoProgressRingStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="FluencyText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                                <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Línea base" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Referencia inicial" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource CaoDividerStyle}"/>
                        <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoGreenSoftBrush}">
                                <FontIcon Glyph="&#xE9D1;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Comparación A/B" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Veredicto con 3% ruido" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource CaoDividerStyle}"/>
                        <TextBlock x:Name="ComparisonText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" FontSize="12"/>
                        <Button x:Name="ExportCsvButton" Content="Exportar CSV" Click="OnExportCsvClick" Style="{StaticResource CaoElevatedButtonStyle}" FontSize="11" Visibility="Collapsed" AutomationProperties.Name="Exportar CSV"/>
                        <TextBlock x:Name="ExportPathText" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed" IsTextSelectionEnabled="True"/>
                        <Grid x:Name="DeltaTable" ColumnSpacing="8" RowSpacing="4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Métrica" FontSize="10" Opacity="0.6" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Antes" FontSize="10" Opacity="0.6" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Después" FontSize="10" Opacity="0.6" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Δ%" FontSize="10" Opacity="0.6" FontWeight="SemiBold" TextAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="CPU" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuBeforeText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="CpuAfterText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="CpuDeltaText" FontSize="11" TextAlignment="Right" FontWeight="SemiBold" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Text="Memoria" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemBeforeText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="MemAfterText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="MemDeltaText" FontSize="11" TextAlignment="Right" FontWeight="SemiBold" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Text="Disco R" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiskRBeforeText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DiskRAfterText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="DiskRDeltaText" FontSize="11" TextAlignment="Right" FontWeight="SemiBold" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="4" Text="Disco W" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DiskWBeforeText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="DiskWAfterText" FontSize="11" TextAlignment="Right" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="DiskWDeltaText" FontSize="11" TextAlignment="Right" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </Grid>
                        <StackPanel x:Name="SparkPanel" Orientation="Horizontal" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Center">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="CPU" FontSize="10" Opacity="0.6" TextAlignment="Center"/>
                                <Polyline x:Name="CpuSpark" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Width="120" Height="36"/>
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Disco R" FontSize="10" Opacity="0.6" TextAlignment="Center"/>
                                <Polyline x:Name="DiskSpark" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Width="120" Height="36"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoGreenSoftBrush}">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Rendimiento seguro (sin overclock directo)" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Lo que sí sube rendimiento sin romper nada" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <TextBlock Text="CA-O no hace overclock de CPU/GPU (frecuencias/voltajes): exige BIOS y herramientas del fabricante, sube temperatura, puede colgar el sistema, anula garantía y provoca baneos con anti-cheat. En su lugar valida estas ganancias seguras y reversibles:" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                    <TextBlock Text="• Plan Alto rendimiento + AC en Best performance  • HAGS + Game Mode + optimización ventana  • GPU dedicada por juego  • Timer 1,0 ms para latencia" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="Ver en Optimizar" Click="OnGoOptimizeClick" Style="{StaticResource CaoGradientButtonStyle}" AutomationProperties.Name="Ir a Optimizar desde Benchmark"/>
                        <Button Content="Timer en Limpieza" Click="OnGoCleanupClick" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Ir a Limpieza timer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Overclock avanzado (solo herramientas vendor)" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Bajo tu responsabilidad y con refrigeración" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <TextBlock Text="Si buscas exprimir más: NVIDIA → MSI Afterburner / GeForce Experience (OC Scanner con curva automática); AMD → Adrenalin Performance Tuning / Ryzen Master; Intel → XTU. Reglas: sube de a poco (+25-50 MHz), prueba estabilidad 15-30 min, vigila &lt;85 °C, no toques voltaje sin saber, y desactiva el OC antes de jugar con Vanguard/EAC." FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <HyperlinkButton Content="MSI Afterburner" NavigateUri="https://www.msi.com/Landing/afterburner" ToolTipService.ToolTip="Herramienta vendor para GPU NVIDIA/AMD"/>
                        <HyperlinkButton Content="AMD Adrenalin" NavigateUri="https://www.amd.com/en/products/software/adrenalin.html" ToolTipService.ToolTip="Tuning oficial AMD"/>
                        <HyperlinkButton Content="Intel XTU" NavigateUri="https://www.intel.com/content/www/us/en/download/17881/intel-extreme-tuning-utility-intel-xtu.html" ToolTipService.ToolTip="Overclock oficial Intel"/>
                    </StackPanel>
                    <TextBlock Text="Usa esta página para validar: mide base → aplica OC vendor → mide después. Si el veredicto es Regresión o el sistema se cuelga, revierte el OC." FontSize="11" Opacity="0.7" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.9">
                <StackPanel Spacing="4">
                    <TextBlock Text="Nota: El benchmark no modifica snapshots ni historial; solo mide rendimiento sin efectos secundarios." FontSize="11" Opacity="0.75" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
