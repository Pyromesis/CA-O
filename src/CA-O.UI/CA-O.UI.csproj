<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <RootNamespace>CAO.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Page Include="MainWindow.xaml" />
    <Page Include="DashboardPage.xaml" />
    <Page Include="AnalyzePage.xaml" />
    <Page Include="OptimizePage.xaml" />
    <Page Include="GamingPage.xaml" />
    <Page Include="DiagnosticsPage.xaml" />
    <Page Include="BenchmarkPage.xaml" />
    <Page Include="RestorePage.xaml" />
    <Page Include="HistoryPage.xaml" />
    <Page Include="SettingsPage.xaml" />
    <Page Include="Resources\DesignTokens.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CA-O.Core\CA-O.Core.csproj" />
    <ProjectReference Include="..\CA-O.Infrastructure\CA-O.Infrastructure.csproj" />
    <ProjectReference Include="..\CA-O.Shared\CA-O.Shared.csproj" />
  </ItemGroup>

</Project>
