<UserControl
    x:Class="CAO.UI.Controls.CaoCat"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mascota CA-O: silueta de gato frame a frame (cada mood con su número
         de fotogramas: ver MascotFlipbook).
         Los PNG viven en Assets/mascot/frames/<tema>/<mood>/fNN.png y cambian
         según el tema claro/oscuro de la ventana.
         La imagen es siempre cuadrada del ancho del control (Width): así el
         tamaño no depende del caption ni del Height que fije la página.
         En tarjetas compactas usar ShowCaption="False" y solo Width. -->
    <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Ping-pong de opacidad: FrameA + FrameB siempre Visible (nunca
             Collapsed, que no carga); una a Opacity 0. Por tick se revela lo
             preparado el tick anterior y se prepara el siguiente en la oculta:
             siempre hay superficie compuesta visible, sin blancos. Sin eventos.
             La respiración vive en el Grid exterior para mover todo a la vez. -->
        <Grid Width="{Binding Width, ElementName=Root, FallbackValue=64}"
              Height="{Binding Width, ElementName=Root, FallbackValue=64}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.9">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="BreathTransform" />
            </Grid.RenderTransform>
            <Grid x:Name="Viewport"
                  Width="{Binding Width, ElementName=Root, FallbackValue=64}"
                  Height="{Binding Width, ElementName=Root, FallbackValue=64}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Image x:Name="FrameA"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
                <Image x:Name="FrameB"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Visibility="Visible"
                       Opacity="0.01" />
            </Grid>
        </Grid>

        <TextBlock x:Name="CaptionText"
                   Margin="0,8,0,0"
                   Text="¿Qué optimizamos hoy?"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
