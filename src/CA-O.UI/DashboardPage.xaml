<Page
    x:Class="CAO.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" Text="Panel" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="LastAnalysisText" Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="AnalyzeButton" Click="OnAnalyzeClick" Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing x:Name="AnalyzingRing" IsActive="False" Width="28" Height="28" />
            </StackPanel>

            <InfoBar
                x:Name="ThermalBar"
                IsOpen="False"
                Severity="Warning"
                Title="Cuello de botella térmico detectado"
                Message="No se recomiendan más cambios de rendimiento hasta resolver la refrigeración." />

            <TextBlock x:Name="HardwareHeader" Text="Hardware y sistema" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Name="SystemSummary" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

            <TextBlock x:Name="BucketsHeader" Text="Recomendaciones tras el análisis" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                    <StackPanel><TextBlock x:Name="RecommendedCount" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="RecommendedLabel" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                    <StackPanel><TextBlock x:Name="OptionalCount" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="OptionalLabel" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                    <StackPanel><TextBlock x:Name="ExperimentalCount" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="ExperimentalLabel" /></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                    <StackPanel><TextBlock x:Name="SecurityCount" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="SecurityLabel" /></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                    <StackPanel><TextBlock x:Name="NotApplicableCount" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="NotApplicableLabel" /></StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="FindingsHeader" Text="Hallazgos" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="FindingsList" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Margin="0,2">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="12" Opacity="0.75" />
                                <TextBlock Text="{Binding MessageEs}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="NoClaimsNote" Opacity="0.55" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
