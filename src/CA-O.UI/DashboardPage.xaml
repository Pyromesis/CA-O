<Page
    x:Class="CAO.UI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">
            <!-- Hero: centro de la app -->
            <Border Style="{StaticResource CaoHeroCardStyle}">
                <Grid>
                    <Border Opacity="0.14" CornerRadius="12" Margin="-20" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TitleText" Style="{StaticResource CaoPageTitleStyle}"/>
                        <TextBlock Text="Tu centro de control: analiza, optimiza, limpia y soluciona desde aquí." Style="{StaticResource CaoSubtitleStyle}"/>
                        <TextBlock x:Name="ProgramInfoText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,6,0,0" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Border x:Name="ServiceBadge" Style="{StaticResource CaoStatusIndicatorStyle}" Background="{ThemeResource SystemFillColorNeutralBrush}">
                                <TextBlock x:Name="ServiceBadgeText" Text="Servicio: —" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="LastAnalysisText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center" MinWidth="240">
                        <Button x:Name="AnalyzeButton" Click="OnAnalyzeClick" Style="{StaticResource CaoAccentButtonStyle}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Analizar sistema"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ProgressRing x:Name="AnalyzingRing" IsActive="False" Width="20" Height="20" Style="{StaticResource CaoProgressRingStyle}"/>
                            <TextBlock x:Name="AnalyzeStatusText" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="NoClaimsNote" FontSize="11" Opacity="0.55" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

            <!-- Avisos globales -->
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" IsClosable="True"
                     Title="Operaciones incompletas por cierre inesperado"
                     Message="CA-O encontró snapshots sin cierre verificado. Revise Restaurar/Historial."/>
            <InfoBar x:Name="ThermalBar" IsOpen="False" Severity="Warning"
                     Title="Cuello de botella térmico"
                     Message="No se recomiendan cambios de rendimiento hasta resolver la refrigeración."/>
            <InfoBar x:Name="PendingRebootBar" IsOpen="False" Severity="Informational" IsClosable="False"
                     Title="Reinicio pendiente"
                     Message="Algunos cambios no surtirán efecto hasta reiniciar."/>
            <InfoBar x:Name="ServiceInfoBar" IsOpen="False" Severity="Informational" IsClosable="False"
                     Title="Modo solo lectura"
                     Message="Diagnósticos disponibles. Para aplicar cambios instale/inicie el servicio privilegiado."/>

            <!-- Accesos directos -->
            <TextBlock x:Name="ShortcutsHeader" Text="Accesos" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Tag="analyze" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE71E;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Analizar" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Diagnóstico completo" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Tag="optimize" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE90F;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Optimizar" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="TileOptimizeSub" Text="Sin recomendaciones" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="2" Tag="cleanup" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Limpieza" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Temporales y timer" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="3" Tag="solucionar" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE897;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Solucionar" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Audio, video, sistema" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Tag="benchmark" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE9D2;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Benchmark" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Medir antes y después" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Tag="restore" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE7A7;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Restaurar" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Snapshots y reversión" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2" Tag="history" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Historial" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Línea auditable" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="3" Tag="settings" Click="OnTileClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Opacity="0.8"/>
                        <TextBlock Text="Ajustes" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Tema, idioma, servicio" FontSize="11" Opacity="0.6"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Estado y programa -->
            <TextBlock x:Name="StatusHeader" Text="Estado y programa" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Próximo paso recomendado" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="NextStepText" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                        <HyperlinkButton x:Name="GoOptimizeButton" Content="Revisar en Optimizar →" FontSize="12" Click="OnGoOptimizeClick"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Acerca de CA-O" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="AboutText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock Text="Diagnóstico primero → recomendaciones por evidencia → transacción con snapshot → benchmark honesto → rollback exacto." FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
