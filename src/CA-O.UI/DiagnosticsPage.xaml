<Page
    x:Class="CAO.UI.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <TextBlock Text="Diagnóstico" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Módulos con estado actual, métricas brutas, interpretación y confianza. Sin telemetría externa." FontSize="12" Opacity="0.6"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RunButton" Content="Ejecutar diagnósticos completos" Click="OnRunClick" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Ejecutar diagnósticos"/>
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22"/>
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B0;" FontSize="13"/><TextBlock Text="Entrada" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                        <TextBlock x:Name="InputText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9CA;" FontSize="13"/><TextBlock Text="Térmico" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                        <TextBlock x:Name="ThermalText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Rendimiento actual" Style="{StaticResource CaoSectionHeaderStyle}" Margin="0,0,0,0"/>
                    <TextBlock x:Name="PerfText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.9"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
