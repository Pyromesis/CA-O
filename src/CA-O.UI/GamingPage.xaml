<Page
    x:Class="CAO.UI.Pages.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource CaoPageContainerStyle}">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Gaming" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Centro gaming: juegos detectados, anti-cheat, perfil recomendado y cambios seguros." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>

            <Border Style="{StaticResource CaoActionCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CaoIconCircleStyle}" Background="{StaticResource CaoPurpleSoftBrush}" Width="44" Height="44">
                        <FontIcon Glyph="&#xE7FC;" FontSize="19" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Detección conservadora" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="GamingStatusText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Text="Escanea juegos y anti-cheats sin modificar nada"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Content="Escanear sistema gaming" Click="OnScanClick" Style="{StaticResource CaoGradientButtonStyle}" AutomationProperties.Name="Escanear sistema gaming"/>
                        <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22" Style="{StaticResource CaoProgressRingStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Anti-cheats detectados" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <InfoBar x:Name="VanguardBar" IsOpen="False" Severity="Warning" IsClosable="False"
                     Title="Anti-cheat presente"
                     Message="Los cambios que reducen seguridad están bloqueados por defecto. CA-O no garantiza compatibilidad de terceros; la detección es conservadora."/>
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoRoseSoftBrush}">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource CaoRoseSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Protección anti-cheat" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Vanguard / EAC / BattlEye bloquean cambios sensibles" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <TextBlock x:Name="AntiCheatText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Juegos detectados (perfiles)" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoGreenSoftBrush}">
                            <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Biblioteca detectada" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Perfiles seguros por juego" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <TextBlock x:Name="GameProfilesText" TextWrapping="Wrap" FontSize="12" Opacity="0.9" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="GPU y pantalla" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="GpuText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                                <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Tecnologías del fabricante" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="VendorText" TextWrapping="Wrap" FontSize="12" Opacity="0.9" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
