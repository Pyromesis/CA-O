<Page
    x:Class="CAO.UI.Pages.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <TextBlock Text="Gaming" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Centro gaming: juegos detectados, anti-cheat, perfil recomendado y cambios seguros." FontSize="12" Opacity="0.6"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ScanButton" Content="Escanear sistema gaming" Click="OnScanClick" Style="{StaticResource AccentButtonStyle}"/>
                <ProgressRing x:Name="Ring" IsActive="False" Width="22" Height="22"/>
                <TextBlock x:Name="GamingStatusText" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Anti-cheats detectados" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <InfoBar x:Name="VanguardBar" IsOpen="False" Severity="Warning" IsClosable="False"
                     Title="Anti-cheat presente"
                     Message="Los cambios que reducen seguridad están bloqueados por defecto. CA-O no garantiza compatibilidad de terceros; la detección es conservadora."/>
            <Border Style="{StaticResource CaoCardStyle}">
                <TextBlock x:Name="AntiCheatText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
            </Border>

            <TextBlock Text="Juegos detectados (perfiles)" Style="{StaticResource CaoSectionHeaderStyle}"/>
            <Border Style="{StaticResource CaoCardStyle}">
                <TextBlock x:Name="GameProfilesText" TextWrapping="Wrap" FontSize="12" Opacity="0.9" IsTextSelectionEnabled="True"/>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="GPU y pantalla" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="GpuText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tecnologías del fabricante" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="VendorText" TextWrapping="Wrap" FontSize="12" Opacity="0.9" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
