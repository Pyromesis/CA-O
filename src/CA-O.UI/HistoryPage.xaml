<Page
    x:Class="CAO.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <TextBlock Text="Historial" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Timeline auditable con TransactionId, operación, verificación y cadena hash. La corrupción genera alerta explícita." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Actualizar" Click="OnRefreshClick"/>
                <ComboBox x:Name="FilterBox" SelectionChanged="OnFilterChanged" MinWidth="180" PlaceholderText="Filtrar: Todo">
                    <ComboBoxItem Content="Todo" Tag="all" IsSelected="True"/>
                    <ComboBoxItem Content="Optimización" Tag="optimization"/>
                    <ComboBoxItem Content="Rollback" Tag="rollback"/>
                    <ComboBoxItem Content="Errores" Tag="error"/>
                    <ComboBoxItem Content="Seguridad" Tag="security"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" PlaceholderText="Buscar por TransactionId / OptimizationId" MinWidth="260" TextChanged="OnSearchChanged"/>
            </StackPanel>
            <Border x:Name="EmptyHistoryCard" Style="{StaticResource CaoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="6" HorizontalAlignment="Center" Padding="12">
                    <FontIcon Glyph="&#xE81C;" FontSize="22" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin historial aún" Style="{StaticResource CaoEmptyStateTitleStyle}"/>
                    <TextBlock Text="Aplique un cambio para generar la primera entrada JSONL en %ProgramData%\CA-O\history.jsonl." FontSize="12" Opacity="0.6" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <InfoBar x:Name="WarningBar" IsOpen="False" Severity="Warning" Title="Historial con entradas corruptas" IsClosable="True"/>
            <TextBlock x:Name="SourceNote" FontSize="11" Opacity="0.55" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <ListView x:Name="HistoryList" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CaoCardStyle}" Padding="12,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="11" Opacity="0.75"/>
                                    </Border>
                                    <TextBlock Text="{Binding Operation}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OptimizationId}" FontSize="12" Opacity="0.7"/>
                                    <Border Background="{Binding StatusBrush}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TransactionHint}" FontSize="10" Opacity="0.45"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
