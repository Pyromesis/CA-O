<Window
    x:Class="CAO.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="CA-O">
    <Grid Padding="24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="CA-O" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Windows Performance Platform" Opacity="0.72" />
        </StackPanel>
        <NavigationView Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" />
                <NavigationViewItem Content="Analyze" Tag="analyze" />
                <NavigationViewItem Content="Optimize" Tag="optimize" />
                <NavigationViewItem Content="Benchmark" Tag="benchmark" />
                <NavigationViewItem Content="Restore" Tag="restore" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame">
                <StackPanel Padding="24" Spacing="16">
                    <TextBlock Text="System analysis" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStatus" Text="Service status: not checked" Opacity="0.72" />
                    <Button Content="Analyze current state" Click="AnalyzeCurrentState" HorizontalAlignment="Left" />
                    <TextBlock x:Name="AnalysisResult" TextWrapping="Wrap" />
                    <TextBlock x:Name="SystemSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="NetworkSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="SecuritySummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="StorageSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriverSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="PerformanceSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="InputSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="ThermalSummary" TextWrapping="Wrap" />
                </StackPanel>
            </Frame>
        </NavigationView>
    </Grid>
</Window>