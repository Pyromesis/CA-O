<Window
    x:Class="CAO.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CA-O">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top contextual bar: Modern design with premium depth -->
        <Border x:Name="TopBar" Grid.Row="0" Padding="18,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Offset="0.0"/>
                    <GradientStop Color="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="CA" FontWeight="Bold" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="TopBarTitle" Text="CA-O" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="TopBarSubtitle" Text="Performance &amp; System Intelligence" FontSize="11" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ServiceDot" Width="10" Height="10" Fill="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="ServiceTopText" FontSize="12" Opacity="0.85" VerticalAlignment="Center" Text="Servicio: comprobando…" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC02;" FontSize="13" Opacity="0.75"/>
                        <TextBlock x:Name="SystemTopText" FontSize="12" Opacity="0.85" VerticalAlignment="Center" Text="Sistema: —" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastScanTopText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" Text="Último análisis: nunca" FontWeight="Medium"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="OperationTopText" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ProgressRing x:Name="OperationTopRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            CompactPaneLength="52"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            IsSettingsVisible="False"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,14,16,12" Spacing="3">
                    <TextBlock Text="CA-O" FontWeight="Bold" FontSize="13" Opacity="0.9"/>
                    <TextBlock Text="Optimización" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel" Tag="dashboard" Icon="Home" ToolTipService.ToolTip="Panel — estado general"/>
                <NavigationViewItem Content="Analizar" Tag="analyze" Icon="Zoom" ToolTipService.ToolTip="Analizar — diagnósticos por área"/>
                <NavigationViewItem Content="Optimizar" Tag="optimize" Icon="Repair" ToolTipService.ToolTip="Optimizar — recomendaciones y cambios transaccionales"/>
                <NavigationViewItem Content="Gaming" Tag="gaming" Visibility="Collapsed" ToolTipService.ToolTip="Gaming — ahora dentro de Analizar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Benchmark" Tag="benchmark" ToolTipService.ToolTip="Benchmark — A/B honesto con suelo de ruido">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restaurar" Tag="restore" Icon="Undo" ToolTipService.ToolTip="Restaurar — snapshots y recuperación"/>
                <NavigationViewItem Content="Historial" Tag="history" ToolTipService.ToolTip="Historial — timeline auditable">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ajustes" Tag="settings" Icon="Setting" ToolTipService.ToolTip="Ajustes — tema, idioma, modo Expert"/>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="14,10,14,14" Spacing="8">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.3"/>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SidebarSystemStatus" Text="Estado: —" FontSize="11" Opacity="0.8" FontWeight="Medium"/>
                        <TextBlock x:Name="SidebarServiceStatus" Text="Servicio: comprobando" FontSize="11" Opacity="0.65"/>
                        <TextBlock x:Name="SidebarBuildText" FontSize="10" Opacity="0.5" IsTextSelectionEnabled="True"/>
                        <TextBlock x:Name="SidebarLastScan" FontSize="10" Opacity="0.5"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
