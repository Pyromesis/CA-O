<Page
    x:Class="CAO.UI.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" Padding="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Optimizar" FontSize="28" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ApplyRecommendedButton" Click="OnApplyRecommendedClick" Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="24" Height="24" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            x:Name="ExpertBar"
            IsOpen="False"
            Severity="Warning"
            Title="Modo Expert"
            Message="Los cambios experimentales y sensibles a seguridad son visibles. Cada aplicación exige confirmación explícita."
            Margin="0,64,0,0" />

        <ListView Grid.Row="2" x:Name="RecommendationsList" SelectionMode="None" Padding="0,8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,4">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding NameEs}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BucketLabel}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RebootLabel}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding DescriptionEs}" TextWrapping="Wrap" Opacity="0.9" />
                            <TextBlock Text="{Binding ReasonMessage}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.75">
                                <TextBlock FontSize="12"><Run Text="Evidencia: " /><Run Text="{Binding Evidence}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Riesgo: " /><Run Text="{Binding Risk}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Seguridad: " /><Run Text="{Binding SecurityImpact}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Compatibilidad: " /><Run Text="{Binding Compatibility}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Estado: " /><Run Text="{Binding CurrentState}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Puntuación: " /><Run Text="{Binding ScoreLabel}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Aplicar" Tag="{Binding OptimizationId}" Click="OnApplyClick" />
                                <Button Content="Revertir" Tag="{Binding OptimizationId}" Click="OnRevertClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
