<Page
    x:Class="CAO.UI.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CAO.UI.Pages">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="Responsive">
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel x:Name="PageContent" Spacing="14" HorizontalAlignment="Stretch">
            <TextBlock Text="Optimizar" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Cada tarjeta muestra diff real, riesgo, seguridad, compatibilidad y reversibilidad. Solo Recomendadas se aplican sin Modo Expert." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ApplyRecommendedButton" Click="OnApplyRecommendedClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Aplicar recomendadas"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <InfoBar x:Name="ExpertBar" IsOpen="False" Severity="Warning"
                     Title="Modo Expert"
                     Message="Los cambios experimentales y sensibles a seguridad son visibles. Cada aplicación exige confirmación explícita y snapshot previo."
                     IsClosable="False"/>

            <!-- Transaction progress (Fase 13) -->
            <Border x:Name="TransactionProgressCard" Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Transacción en curso" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="TxRing" Width="16" Height="16" IsActive="True"/>
                        <TextBlock x:Name="TxText" FontSize="12" VerticalAlignment="Center" Text="Preparando…"/>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Precondiciones ✓  ·  Snapshot ✓  ·  Aplicando ●  ·  Verificación ○  ·  Commit ○" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Recomendaciones" FontWeight="SemiBold" FontSize="13" Opacity="0.85"/>

            <Border x:Name="EmptyStateCard" Style="{StaticResource CaoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="12">
                    <FontIcon Glyph="&#xE946;" FontSize="24" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin recomendaciones" Style="{StaticResource CaoEmptyStateTitleStyle}"/>
                    <TextBlock Text="Ejecute primero Analizar sistema en el Panel. No hay nada para optimizar hasta generar un contexto medido." FontSize="12" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ListView x:Name="RecommendationsList" SelectionMode="None" Padding="0,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,6"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CaoCardStyle}">
                            <StackPanel Spacing="10">
                                <!-- Header -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE8EE;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding NameEs}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BucketLabel}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{Binding LockVisibility}" ToolTipService.ToolTip="{Binding LockReason}"/>
                                            <TextBlock Text="{Binding RebootLabel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DescriptionEs}" TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>
                                        <TextBlock Text="{Binding BenefitDetail}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9"/>
                                        <TextBlock Text="{Binding ReasonMessage}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" FontStyle="Italic"/>
                                        <TextBlock Text="{Binding LockReason}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="{Binding LockVisibility}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="{Binding ScoreLabel}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Evidence / Risk / Security / Compatibility (Fase 10) -->
                                <Grid ColumnSpacing="10" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="POR QUÉ" FontSize="10" Opacity="0.55" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap"><Run Text="Evidencia: "/><Run Text="{Binding Evidence}" FontWeight="SemiBold"/><Run Text=" · Confianza: "/><Run Text="{Binding ScoreLabel}"/></TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.7"><Run Text="Estado actual: "/><Run Text="{Binding CurrentState}"/></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="IMPACTO" FontSize="10" Opacity="0.55" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11"><Run Text="Riesgo: "/><Run Text="{Binding Risk}"/></TextBlock>
                                            <TextBlock FontSize="11"><Run Text="Seguridad: "/><Run Text="{Binding SecurityImpact}"/></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="REVERSIBILIDAD" FontSize="10" Opacity="0.55" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11"><Run Text="Compatibilidad: "/><Run Text="{Binding Compatibility}"/></TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.7">Rollback: disponible (snapshot por TX)</TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button Content="Detalles" Tag="{Binding OptimizationId}" Click="OnPreviewClick" FontSize="12" AutomationProperties.Name="Ver diff antes/después" AutomationProperties.HelpText="Muestra registry/valor antes y después"/>
                                    <Button Content="Aplicar" Tag="{Binding OptimizationId}" Click="OnApplyClick" Style="{StaticResource AccentButtonStyle}" FontSize="12" IsEnabled="{Binding IsApplyEnabled}" AutomationProperties.Name="Aplicar optimización" AutomationProperties.HelpText="Crea snapshot por TransactionId, aplica y verifica"/>
                                    <Button Content="Revertir" Tag="{Binding OptimizationId}" Click="OnRevertClick" FontSize="12" Opacity="0.9" AutomationProperties.Name="Revertir cambio" AutomationProperties.HelpText="Restaura snapshot exacto verificado"/>
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{Binding LockVisibility}" ToolTipService.ToolTip="Bloqueado — requiere Modo Expert o anti-cheat"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Cada aplicación crea un snapshot previo por TransactionId, verifica exactamente y permite reversión precisa." FontSize="11" Opacity="0.45" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
