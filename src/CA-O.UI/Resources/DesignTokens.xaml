<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CA-O Modern Design System — Enhanced UI/UX with animations and polish -->
    <!-- Spacing System: 4/8/12/16/20/24/28/32/40/48/64 (perfect octal scale) -->
    <x:Double x:Key="CaoSpace2">2</x:Double>
    <x:Double x:Key="CaoSpace4">4</x:Double>
    <x:Double x:Key="CaoSpace8">8</x:Double>
    <x:Double x:Key="CaoSpace12">12</x:Double>
    <x:Double x:Key="CaoSpace16">16</x:Double>
    <x:Double x:Key="CaoSpace20">20</x:Double>
    <x:Double x:Key="CaoSpace24">24</x:Double>
    <x:Double x:Key="CaoSpace28">28</x:Double>
    <x:Double x:Key="CaoSpace32">32</x:Double>

    <x:Double x:Key="CaoFontSizeTitleLarge">28</x:Double>
    <x:Double x:Key="CaoFontSizeTitle">20</x:Double>
    <x:Double x:Key="CaoFontSizeSection">16</x:Double>
    <x:Double x:Key="CaoFontSizeBody">14</x:Double>
    <x:Double x:Key="CaoFontSizeCaption">12</x:Double>
    <x:Double x:Key="CaoFontSizeMetric">26</x:Double>

    <Thickness x:Key="CaoCardPadding">16,16,16,16</Thickness>
    <Thickness x:Key="CaoCardPaddingCompact">12,12,12,12</Thickness>
    <Thickness x:Key="CaoPagePadding">28,20,28,20</Thickness>
    <Thickness x:Key="CaoSectionMargin">0,16,0,0</Thickness>

    <Style x:Key="CaoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="{StaticResource CaoCardPadding}"/>
    </Style>

    <Style x:Key="CaoCardElevatedStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CaoMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="16,16,16,16"/>
        <Setter Property="MinHeight" Value="96"/>
    </Style>

    <!-- Modern Accent Button Style with hover effects -->
    <Style x:Key="CaoAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,10,16,10"/>
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Elevated Button for secondary actions -->
    <Style x:Key="CaoElevatedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,8,14,8"/>
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeCaption}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="CaoSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource CaoSectionMargin}"/>
    </Style>

    <Style x:Key="CaoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Subtitle style for page descriptions -->
    <Style x:Key="CaoSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CaoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeCaption}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style x:Key="CaoBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3,8,3"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="CaoEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Semantic color tokens (§56) — no color solo por estética -->
    <SolidColorBrush x:Key="CaoSuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="CaoWarningBrush" Color="#ED6C02"/>
    <SolidColorBrush x:Key="CaoDangerBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="CaoCriticalBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="CaoInfoBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="CaoNeutralBrush" Color="#616161"/>
    <SolidColorBrush x:Key="CaoExperimentalBrush" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="CaoSecurityBrush" Color="#C62828"/>

    <!-- Typography scale (§57) -->
    <x:Double x:Key="CaoFontSizeDisplay">32</x:Double>
    <x:Double x:Key="CaoFontSizeH1">24</x:Double>
    <x:Double x:Key="CaoFontSizeH2">18</x:Double>
    <x:Double x:Key="CaoFontSizeH3">14</x:Double>
    <x:Double x:Key="CaoFontSizeMetricLarge">30</x:Double>

    <!-- Spacing centralized 4/8/12/16/24/32/40/48/64 (§58) -->
    <x:Double x:Key="CaoSpace40">40</x:Double>
    <x:Double x:Key="CaoSpace48">48</x:Double>
    <x:Double x:Key="CaoSpace64">64</x:Double>

    <!-- Radius & elevation (§59) -->
    <CornerRadius x:Key="CaoRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CaoRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CaoRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CaoRadiusXLarge">16</CornerRadius>

    <!-- Animation Duration Constants -->
    <x:Double x:Key="CaoAnimationDurationFast">200</x:Double>
    <x:Double x:Key="CaoAnimationDurationNormal">300</x:Double>
    <x:Double x:Key="CaoAnimationDurationSlow">500</x:Double>

    <!-- Modern Progress Ring Style -->
    <Style x:Key="CaoProgressRingStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Style>

    <!-- Hero Section Card for Dashboard -->
    <Style x:Key="CaoHeroCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="Padding" Value="20,20,20,20"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="140"/>
    </Style>

    <!-- Status Indicator Style -->
    <Style x:Key="CaoStatusIndicatorStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Info Bar Enhancements -->
    <x:Double x:Key="CaoInfoBarCornerRadius">10</x:Double>

    <!-- TextBox and ComboBox Input Styles -->
    <Style x:Key="CaoTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="CaoComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <!-- Enhanced Button Styles with transition potential -->
    <Style x:Key="CaoButtonBaseStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8,14,8"/>
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
    </Style>

    <!-- Outlined Button Style -->
    <Style x:Key="CaoOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Text Button Style (Ghost Button) -->
    <Style x:Key="CaoTextButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- List View Item Enhanced Style -->
    <Style x:Key="CaoListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ScrollViewer Enhancement -->
    <Style x:Key="CaoScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Grid with Enhanced Spacing -->
    <Style x:Key="CaoGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12"/>
        <Setter Property="RowSpacing" Value="12"/>
    </Style>

    <!-- StackPanel with Improved Spacing -->
    <Style x:Key="CaoStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <!-- Card with Hover Ready (base for transitions) -->
    <Style x:Key="CaoInteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Section Container for grouped content -->
    <Style x:Key="CaoSectionContainerStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- Info Bar Variant Styles -->
    <Style x:Key="CaoInfoBarContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>

    <!-- Loading State Indicator -->
    <Style x:Key="CaoLoadingIndicatorStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="IsActive" Value="False"/>
    </Style>

    <!-- Transition Duration Values (for future animation implementation) -->
    <Duration x:Key="CaoAnimationDurationFastDuration">00:00:00.2</Duration>
    <Duration x:Key="CaoAnimationDurationNormalDuration">00:00:00.3</Duration>
    <Duration x:Key="CaoAnimationDurationSlowDuration">00:00:00.5</Duration>

    <!-- Empty State Container -->
    <Style x:Key="CaoEmptyStateContainerStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Content Card with Subtle Elevation Feel -->
    <Style x:Key="CaoContentCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
