<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CA-O Premium Design System — elegante, profesional, de confianza -->
    <!-- Paleta sobria multicolor: azul confianza + acentos semánticos suaves -->
    <!-- Spacing System: 4/8/12/16/20/24/28/32/40/48/64 (perfect octal scale) -->
    <x:Double x:Key="CaoSpace2">2</x:Double>
    <x:Double x:Key="CaoSpace4">4</x:Double>
    <x:Double x:Key="CaoSpace8">8</x:Double>
    <x:Double x:Key="CaoSpace12">12</x:Double>
    <x:Double x:Key="CaoSpace16">16</x:Double>
    <x:Double x:Key="CaoSpace20">20</x:Double>
    <x:Double x:Key="CaoSpace24">24</x:Double>
    <x:Double x:Key="CaoSpace28">28</x:Double>
    <x:Double x:Key="CaoSpace32">32</x:Double>

    <x:Double x:Key="CaoFontSizeTitleLarge">28</x:Double>
    <x:Double x:Key="CaoFontSizeTitle">20</x:Double>
    <x:Double x:Key="CaoFontSizeSection">16</x:Double>
    <x:Double x:Key="CaoFontSizeBody">14</x:Double>
    <x:Double x:Key="CaoFontSizeCaption">12</x:Double>
    <x:Double x:Key="CaoFontSizeMetric">26</x:Double>

    <Thickness x:Key="CaoCardPadding">16,16,16,16</Thickness>
    <Thickness x:Key="CaoCardPaddingCompact">12,12,12,12</Thickness>
    <Thickness x:Key="CaoPagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="CaoSectionMargin">0,16,0,0</Thickness>

    <Style x:Key="CaoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20,20,20,20"/>
    </Style>

    <Style x:Key="CaoCardElevatedStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CaoMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="16,16,16,16"/>
        <Setter Property="MinHeight" Value="104"/>
    </Style>

    <!-- Pinceles de marca: color de acento del SISTEMA (nativo Win11, sin degradados) -->
    <SolidColorBrush x:Key="CaoBrandGradientBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="CaoHeroGlowBrush" Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="CaoSuccessGradientBrush" Color="#16A34A"/>

    <!-- Fondos de icono neutros (gris sistema, estilo nativo Win11) -->
    <SolidColorBrush x:Key="CaoBlueSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoGreenSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoAmberSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoPurpleSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoCyanSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoRoseSoftBrush" Color="#808080" Opacity="0.12"/>
    <SolidColorBrush x:Key="CaoSlateSoftBrush" Color="#808080" Opacity="0.12"/>

    <!-- Iconos en gris secundario del tema (monocromo nativo) -->
    <SolidColorBrush x:Key="CaoBlueSolidBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="CaoGreenSolidBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="CaoAmberSolidBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="CaoPurpleSolidBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="CaoCyanSolidBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="CaoRoseSolidBrush" Color="#605E5C"/>

    <!-- Círculo de icono premium 40px -->
    <Style x:Key="CaoIconCircleStyle" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="CaoEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style x:Key="CaoHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Píldora de confianza -->
    <Style x:Key="CaoTrustPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,6,10,6"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Modern Accent Button Style with hover effects -->
    <Style x:Key="CaoAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"/>
        <Setter Property="Padding" Value="18,11,18,11"/>
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- Botón principal: color de acento del sistema (mismo que CaoAccentButtonStyle) -->
    <Style x:Key="CaoGradientButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoAccentButtonStyle}"/>

    <!-- Elevated Button for secondary actions -->
    <Style x:Key="CaoElevatedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,9,14,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style x:Key="CaoSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource CaoSectionMargin}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Centered page header container: title + subtitle, used by every page -->
    <Style x:Key="CaoPageHeaderStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CaoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Subtitle style for page descriptions -->
    <Style x:Key="CaoSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Barra de acento sobria: sigue el color de acento del sistema -->
    <LinearGradientBrush x:Key="CaoAccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}"/>
        <GradientStop Offset="0.5" Color="{ThemeResource SystemAccentColor}"/>
        <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark1}"/>
    </LinearGradientBrush>

    <!-- Círculo numerado para flujos (benchmark, análisis) -->
    <Style x:Key="CaoStepCircleStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="{StaticResource CaoBrandGradientBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Tarjeta de acción principal: fondo con tinte de marca muy sutil -->
    <Style x:Key="CaoActionCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="18,16,18,16"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Título de sección con jerarquía premium (izquierda, no centrado) -->
    <Style x:Key="CaoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="CaoSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CaoHeaderAccentBarStyle" TargetType="Border">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Width" Value="72"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,10,0,2"/>
        <Setter Property="Background" Value="{StaticResource CaoAccentBarBrush}"/>
    </Style>

    <!-- Accent-tinted glyphs for dashboard tiles -->
    <Style x:Key="CaoTileIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="CaoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeCaption}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style x:Key="CaoBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3,8,3"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="CaoEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Semantic color tokens (§56) — no color solo por estética -->
    <SolidColorBrush x:Key="CaoSuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="CaoWarningBrush" Color="#ED6C02"/>
    <SolidColorBrush x:Key="CaoDangerBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="CaoCriticalBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="CaoInfoBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="CaoNeutralBrush" Color="#616161"/>
    <SolidColorBrush x:Key="CaoExperimentalBrush" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="CaoSecurityBrush" Color="#C62828"/>

    <!-- Typography scale (§57) -->
    <x:Double x:Key="CaoFontSizeDisplay">32</x:Double>
    <x:Double x:Key="CaoFontSizeH1">24</x:Double>
    <x:Double x:Key="CaoFontSizeH2">18</x:Double>
    <x:Double x:Key="CaoFontSizeH3">14</x:Double>
    <x:Double x:Key="CaoFontSizeMetricLarge">30</x:Double>

    <!-- Spacing centralized 4/8/12/16/24/32/40/48/64 (§58) -->
    <x:Double x:Key="CaoSpace40">40</x:Double>
    <x:Double x:Key="CaoSpace48">48</x:Double>
    <x:Double x:Key="CaoSpace64">64</x:Double>

    <!-- Radius & elevation (§59) -->
    <CornerRadius x:Key="CaoRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CaoRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CaoRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CaoRadiusXLarge">16</CornerRadius>

    <!-- Animation Duration Constants -->
    <x:Double x:Key="CaoAnimationDurationFast">200</x:Double>
    <x:Double x:Key="CaoAnimationDurationNormal">300</x:Double>
    <x:Double x:Key="CaoAnimationDurationSlow">500</x:Double>

    <!-- Modern Progress Ring Style -->
    <Style x:Key="CaoProgressRingStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Style>

    <!-- Hero Section Card for Dashboard -->
    <Style x:Key="CaoHeroCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="Padding" Value="28,28,28,28"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="MinHeight" Value="190"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Status Indicator Style -->
    <Style x:Key="CaoStatusIndicatorStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Info Bar Enhancements -->
    <x:Double x:Key="CaoInfoBarCornerRadius">10</x:Double>

    <!-- TextBox and ComboBox Input Styles -->
    <Style x:Key="CaoTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="CaoComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <!-- Enhanced Button Styles with transition potential -->
    <Style x:Key="CaoButtonBaseStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8,14,8"/>
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeBody}"/>
    </Style>

    <!-- Outlined Button Style -->
    <Style x:Key="CaoOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Text Button Style (Ghost Button) -->
    <Style x:Key="CaoTextButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- List View Item Enhanced Style -->
    <Style x:Key="CaoListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ScrollViewer Enhancement -->
    <Style x:Key="CaoScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Grid with Enhanced Spacing -->
    <Style x:Key="CaoGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12"/>
        <Setter Property="RowSpacing" Value="12"/>
    </Style>

    <!-- StackPanel with Improved Spacing -->
    <Style x:Key="CaoStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <!-- Card with Hover Ready (base for transitions) -->
    <Style x:Key="CaoInteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Section Container for grouped content -->
    <Style x:Key="CaoSectionContainerStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- Info Bar Variant Styles -->
    <Style x:Key="CaoInfoBarContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>

    <!-- Loading State Indicator -->
    <Style x:Key="CaoLoadingIndicatorStyle" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="IsActive" Value="False"/>
    </Style>

    <!-- Transition Duration Values (for future animation implementation) -->
    <Duration x:Key="CaoAnimationDurationFastDuration">00:00:00.2</Duration>
    <Duration x:Key="CaoAnimationDurationNormalDuration">00:00:00.3</Duration>
    <Duration x:Key="CaoAnimationDurationSlowDuration">00:00:00.5</Duration>

    <!-- Empty State Container -->
    <Style x:Key="CaoEmptyStateContainerStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Content Card with Subtle Elevation Feel -->
    <Style x:Key="CaoContentCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Reusable page container: centered 1200px, 20px section rhythm -->
    <Style x:Key="CaoPageContainerStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="20"/>
        <Setter Property="MaxWidth" Value="1200"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Thin divider line used between card sections -->
    <Style x:Key="CaoDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Stable filter buttons: no layout jump when counts change -->
    <Style x:Key="CaoFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoElevatedButtonStyle}">
        <Setter Property="MinWidth" Value="132"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Dashboard / shortcut tiles -->
    <Style x:Key="CaoTileButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoElevatedButtonStyle}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="MinHeight" Value="104"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Uniform action buttons inside Limpieza / Solucionar -->
    <Style x:Key="CaoActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoElevatedButtonStyle}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
