<Page
    x:Class="CAO.UI.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel Style="{StaticResource CaoPageContainerStyle}">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Restaurar" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Centro de restauración — snapshots por TransactionId, no por OptimizationId. Cada reversión se verifica exactamente." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>
            <InfoBar x:Name="NoteBar" IsOpen="True" Severity="Informational" IsClosable="False"
                     Title="Reversibilidad garantizada"
                     Message="CA-O crea snapshots propios antes de cada cambio; el punto de restauración de Windows se solicita una vez por sesión cuando el sistema lo permite. Irreversibles se marcan explícitamente."/>
            <Border Style="{StaticResource CaoActionCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CaoIconCircleStyle}" Background="{StaticResource CaoGreenSoftBrush}" Width="44" Height="44">
                        <FontIcon Glyph="&#xE7A7;" FontSize="19" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Red de seguridad" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Cada TX guarda estado exacto antes de mutar" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Actualizar lista" Click="OnRefreshClick" Style="{StaticResource CaoGradientButtonStyle}" AutomationProperties.Name="Actualizar lista de snapshots"/>
                        <Button x:Name="OpenHistoryButton" Content="Ver historial" Click="OnGoHistoryClick" Opacity="0.9" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Ver historial"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                                <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Últimas operaciones" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="TX, riesgo y estado" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CaoCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Recuperación tras cierre" Style="{StaticResource CaoSectionTitleStyle}"/>
                                <TextBlock Text="Crash-safe por diseño" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="RecoveryHintText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Text="Sin recuperaciones pendientes."/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="EmptySnapshotsCard" Style="{StaticResource CaoCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="6" HorizontalAlignment="Center" Padding="12">
                    <FontIcon Glyph="&#xE777;" FontSize="22" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin snapshots aún" Style="{StaticResource CaoEmptyStateTitleStyle}"/>
                    <TextBlock Text="Los snapshots aparecen aquí tras aplicar un cambio. Se guardan en %ProgramData%\CA-O\snapshots\{TX}\." FontSize="12" Opacity="0.6" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <ListView x:Name="SnapshotsList" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CaoCardStyle}" Padding="0">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CaoSuccessGradientBrush}" CornerRadius="3,0,0,3" Opacity="0.9"/>
                                <Grid ColumnSpacing="10" Grid.Column="1" Padding="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True">
                                        <Run Text="{Binding TimestampUtc}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding OptimizationId}" />
                                        <Run Text=" — TX:" />
                                        <Run Text="{Binding TransactionId}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding EntryCount}" />
                                        <Run Text=" valores — build " />
                                        <Run Text="{Binding WindowsBuild}" />
                                    </TextBlock>
                                    <TextBlock Text="TransactionId como identidad primaria — nunca se sobrescribe un snapshot." FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Inspeccionar" Tag="{Binding TransactionId}" Click="OnInspectClick" FontSize="12" MinHeight="32" Style="{StaticResource CaoElevatedButtonStyle}" AutomationProperties.Name="Inspeccionar snapshot"/>
                                    <Button Content="Restaurar" Tag="{Binding TransactionId}" Click="OnRestoreClick" FontSize="12" MinHeight="32" MinWidth="110" Style="{StaticResource CaoGradientButtonStyle}" AutomationProperties.Name="Restaurar snapshot"/>
                                </StackPanel>
                            </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
