<Page
    x:Class="CAO.UI.Pages.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Restaurar" FontSize="28" FontWeight="SemiBold" />
            <InfoBar x:Name="NoteBar" IsOpen="True" Severity="Informational" Message="" />
            <TextBlock Text="Snapshots de CA-O" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Button Content="Actualizar lista" Click="OnRefreshClick" />
            <ListView x:Name="SnapshotsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
