<Page
    x:Class="CAO.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="PageContent" Style="{StaticResource CaoPageContainerStyle}">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Ajustes" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Organizados por categorías. Sin listas infinitas." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>

            <!-- General / Appearance -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBlueSoftBrush}">
                            <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Apariencia" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Tema y idioma al instante" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="OnThemeSelected" MinWidth="200" Style="{StaticResource CaoComboBoxStyle}">
                            <ComboBoxItem Content="Sistema (predeterminado)" Tag="system" IsSelected="True"/>
                            <ComboBoxItem Content="Claro" Tag="light" />
                            <ComboBoxItem Content="Oscuro" Tag="dark" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                        <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" SelectionChanged="OnLanguageSelected" MinWidth="200" Style="{StaticResource CaoComboBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Optimization policy -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoAmberSoftBrush}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource CaoAmberSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Política de optimización" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="Control de riesgo y visibilidad" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Modo Expert" FontSize="13" FontWeight="Medium"/>
                        <ToggleSwitch x:Name="ExpertSwitch" OnContent="Activado" OffContent="Desactivado" Toggled="OnExpertToggled"
                                      AutomationProperties.Name="Modo Expert" MinWidth="100"/>
                        <TextBlock Text="Expone cambios experimentales, sensibles a seguridad y heredados. Cada aplicación exige confirmación explícita y crea snapshot automático." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <InfoBar x:Name="ExpertWarnBar" IsOpen="False" Severity="Warning"
                             Title="Modo Expert: Mayor riesgo"
                             Message="Solo para usuarios avanzados. Nunca aplica cambios sin confirmación explícita ni snapshot previo."
                             IsClosable="True"/>
                </StackPanel>
            </Border>

            <!-- Security / Service -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoBrandGradientBrush}">
                            <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Servicio privilegiado" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="SYSTEM • Pipe seguro • Anti-replay" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Se necesita elevación para aplicar cambios reales en el sistema." FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                            <TextBlock Text="CA-O usa un servicio privilegiado con pipe autenticado, nonce y rollback seguro." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Explicación clara de por qué y qué -->
                        <InfoBar x:Name="ServiceExplanationBar" IsOpen="True" Severity="Informational" IsClosable="False"
                                 Title="¿Por qué instalar el servicio privilegiado?"
                                 Message="Para aplicar optimizaciones (registro, servicios, planes de energía, DNS, etc.) se requieren permisos de SYSTEM. El servicio CAO.Privileged se ejecuta como SYSTEM y expone un Named Pipe seguro (ACL solo administradores, nonce, expiración 30s, anti-replay). La UI nunca tiene privilegios; cada acción validada viaja por este canal cifrado y auditado." />

                        <Border CornerRadius="10" Padding="14,12,14,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressRing x:Name="ServiceRing" IsActive="False" Width="20" Height="20" Style="{StaticResource CaoProgressRingStyle}"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ServiceStatusText" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ServiceDetailText" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button x:Name="ServiceCheckButton"
                                    Content="Comprobar servicio privilegiado"
                                    Click="OnServiceCheckClick"
                                    Style="{StaticResource CaoOutlineButtonStyle}"
                                    MinHeight="38"/>

                            <Button x:Name="ServiceInstallButton"
                                    Content="Instalar ahora"
                                    Click="OnServiceInstallClick"
                                    Style="{StaticResource CaoAccentButtonStyle}"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    MinHeight="38"
                                    Visibility="Visible"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,6,0,0">
                        <TextBlock x:Name="VersionsText" FontSize="11" Opacity="0.7" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PrivilegeText" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actualizaciones -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource CaoGreenSoftBrush}">
                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Actualizaciones" Style="{StaticResource CaoSectionTitleStyle}"/>
                            <TextBlock Text="GitHub Releases con progreso" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="UpdateStatusText" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Text="Versión instalada: —"/>
                            <TextBlock x:Name="UpdateDetailText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="Comprueba si hay una versión nueva en GitHub Releases."/>
                        </StackPanel>

                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" MinHeight="4"/>

                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="UpdateCheckButton"
                                    Content="Buscar actualizaciones"
                                    Click="OnUpdateCheckClick"
                                    Style="{StaticResource CaoOutlineButtonStyle}"
                                    MinHeight="38"/>

                            <Button x:Name="UpdateDownloadButton"
                                    Content="Descargar e instalar"
                                    Click="OnUpdateDownloadClick"
                                    Style="{StaticResource CaoAccentButtonStyle}"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    MinHeight="38"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource CaoBrandGradientBrush}">
                            <TextBlock Text="CA" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Sobre CA-O" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Filosofía y principios" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <TextBlock Text="Filosofía de diseño" FontWeight="SemiBold" FontSize="12" Opacity="0.9"/>
                    <TextBlock Text="Diagnóstico primero → recomendaciones por evidencia → transacción con snapshot y verificación → benchmark honesto → rollback exacto. Sin promesas numéricas falsas, solo hechos medibles." FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    <StackPanel Spacing="6" Margin="0,8,0,0">
                        <TextBlock Text="Principios clave:" FontWeight="Medium" FontSize="11" Opacity="0.85"/>
                        <StackPanel Spacing="4" Margin="12,0,0,0">
                            <TextBlock Text="• Reversibilidad garantizada con snapshots" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                            <TextBlock Text="• Transacciones ACID: todo o nada" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                            <TextBlock Text="• Benchmark con tolerancia de ruido 3%" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                            <TextBlock Text="• Seguridad primero: sin riesgos no medidos" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
