<Page
    x:Class="CAO.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Center">
            <TextBlock Text="Ajustes" Style="{StaticResource CaoPageTitleStyle}"/>
            <TextBlock Text="Organizados por categorías. Sin listas infinitas." FontSize="12" Opacity="0.6"/>

            <!-- General / Appearance -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="OnThemeSelected" MinWidth="180">
                            <ComboBoxItem Content="Sistema" Tag="system" />
                            <ComboBoxItem Content="Claro" Tag="light" />
                            <ComboBoxItem Content="Oscuro" Tag="dark" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" SelectionChanged="OnLanguageSelected" MinWidth="180"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Optimization policy -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Política de optimización" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="ExpertSwitch" OnContent="Activado" OffContent="Desactivado" Toggled="OnExpertToggled"
                                  AutomationProperties.Name="Modo Expert"/>
                    <InfoBar x:Name="ExpertWarnBar" IsOpen="False" Severity="Warning"
                             Title="Modo Expert"
                             Message="Muestra cambios experimentales, sensibles a seguridad y heredados. Cada aplicación exige confirmación explícita y crea snapshot."
                             IsClosable="False"/>
                    <TextBlock Text="Expert expone Security Sensitive y Experimental solo para revisión avanzada. Nunca aplica sin confirmación ni snapshot." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Security / Service -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Servicio privilegiado" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ServiceButton" Click="OnServiceCheckClick"/>
                        <ProgressRing x:Name="ServiceRing" IsActive="False" Width="20" Height="20"/>
                        <TextBlock x:Name="ServiceStatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock x:Name="VersionsText" FontSize="11" Opacity="0.55" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PrivilegeText" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CaoCardStyle}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="CA-O — Filosofía" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="Diagnóstico primero → recomendaciones por evidencia → transacción con snapshot y verificación → benchmark honesto → rollback exacto. Sin promesas numéricas." FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
