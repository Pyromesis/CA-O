<Page
    x:Class="CAO.UI.Pages.SolucionarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Solucionar problemas" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Soluciones directas para fallos comunes. Cada una actúa de verdad y confirma antes de cambios delicados." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
            </StackPanel>

            <!-- Audio -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Audio" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                    <Button Content="Reiniciar servicios de audio" Tag="restart-windows-audio-services" Click="OnFixClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <Button Content="Permitir acceso al micrófono" Tag="fix-microphone-access" Click="OnFixClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <Button Content="Volumen independiente en Bluetooth" Tag="disable-bluetooth-absolute-volume" Click="OnFixClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AudioStatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Video y pantalla -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Video y pantalla" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                    <Button Content="Reiniciar compositor (parpadeos)" Tag="restart-desktop-compositor" Click="OnFixConfirmClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <Button Content="Limpiar caché de iconos" Tag="clear-icon-thumbnail-cache" Click="OnFixClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VideoStatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Sistema -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sistema" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>
                    <Button Content="Reparar Windows Update" Tag="repair-windows-update" Click="OnFixConfirmClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <Button Content="Resincronizar reloj" Tag="resync-system-clock" Click="OnFixClick" FontSize="12" MinHeight="38" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SystemStatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
