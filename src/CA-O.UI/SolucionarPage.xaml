<Page
    x:Class="CAO.UI.Pages.SolucionarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CAO.UI.Controls">
    <Page.Resources>
        <!-- Botón de acción de esta página: estilo compartido + ancho mínimo único -->
        <Style x:Key="SolucionarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaoActionButtonStyle}">
            <Setter Property="MinWidth" Value="320"/>
        </Style>
    </Page.Resources>
    <Grid>
    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="PageContent" Style="{StaticResource CaoPageContainerStyle}">
            <StackPanel Style="{StaticResource CaoPageHeaderStyle}">
                <TextBlock Text="Solucionar problemas" TextAlignment="Center" Style="{StaticResource CaoPageTitleStyle}"/>
                <TextBlock Text="Soluciones directas para fallos comunes. Cada una actúa de verdad y confirma antes de cambios delicados." TextAlignment="Center" Style="{StaticResource CaoSubtitleStyle}"/>
                <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
            </StackPanel>

            <!-- Progreso movido al overlay ApplyOverlay (centrado + bloqueante) -->

            <!-- Audio -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:CaoCat x:Name="SolucionarCat" Width="48" ShowCaption="False" VerticalAlignment="Center"
                                         AutomationProperties.Name="Mascota de CA-O"/>
                        <Border Style="{StaticResource CaoCardIconStyle}" Background="{StaticResource CaoBlueSoftBrush}">
                            <FontIcon Glyph="&#xE995;" FontSize="16" Foreground="{StaticResource CaoBlueSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Audio" Style="{StaticResource CaoCardTitleStyle}"/>
                            <TextBlock Text="Servicios, micro y Bluetooth" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Button Content="Reiniciar servicios de audio" Tag="restart-windows-audio-services" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar servicios de audio" ToolTipService.ToolTip="Reinicia Audiosrv y AudioEndpointBuilder. Solución habitual cuando no hay sonido. Unos segundos sin audio."/>
                    <Button Content="Permitir acceso al micrófono" Tag="fix-microphone-access" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Permitir acceso al micrófono" ToolTipService.ToolTip="Pone el acceso al micrófono en Permitir (registro). Para apps que no captan audio."/>
                    <Button Content="Volumen independiente en Bluetooth" Tag="disable-bluetooth-absolute-volume" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Volumen independiente en Bluetooth" ToolTipService.ToolTip="Separa el volumen de Windows y del dispositivo Bluetooth. Útil si el volumen va a saltos."/>
                    <Button Content="Reiniciar Bluetooth (no empareja)" Tag="restart-bluetooth-service" Click="OnFixConfirmClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar servicio Bluetooth" ToolTipService.ToolTip="Reinicia bthserv. Para Bluetooth que no empareja o desaparece. Se conservan los emparejados."/>
                    <TextBlock x:Name="AudioStatusText" Style="{StaticResource CaoSectionSubtitleStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Video y pantalla -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource CaoCardIconStyle}" Background="{StaticResource CaoPurpleSoftBrush}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource CaoPurpleSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Video y pantalla" Style="{StaticResource CaoCardTitleStyle}"/>
                            <TextBlock Text="Compositor e iconos" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Button Content="Reiniciar compositor (parpadeos)" Tag="restart-desktop-compositor" Click="OnFixConfirmClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar compositor de escritorio" ToolTipService.ToolTip="Reinicia DWM: la pantalla parpadea unos segundos. Para parpadeos o negro. Vuelve solo."/>
                    <Button Content="Limpiar caché de iconos" Tag="clear-icon-thumbnail-cache" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Limpiar caché de iconos" ToolTipService.ToolTip="Borra cachés de iconos y miniaturas dañadas. El sistema las regenera solo."/>
                    <TextBlock x:Name="VideoStatusText" Style="{StaticResource CaoSectionSubtitleStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Red -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource CaoCardIconStyle}" Background="{StaticResource CaoCyanSoftBrush}">
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource CaoCyanSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Red" Style="{StaticResource CaoCardTitleStyle}"/>
                            <TextBlock Text="DNS y conectividad" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Button Content="Vaciar caché DNS" Tag="flush-dns-cache" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Vaciar caché DNS" ToolTipService.ToolTip="Ejecuta ipconfig /flushdns. Arregla webs que no cargan tras cambiar de red. Inmediato y repetible."/>
                    <Button Content="Reiniciar cliente DNS" Tag="restart-dns-client" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar cliente DNS" ToolTipService.ToolTip="Reinicia el cliente DNS (Dnscache). Para errores de resolución persistentes. Complementa vaciar la caché."/>
                    <TextBlock x:Name="NetworkStatusText" Style="{StaticResource CaoSectionSubtitleStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Impresión -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource CaoCardIconStyle}" Background="{StaticResource CaoSlateSoftBrush}">
                            <FontIcon Glyph="&#xE749;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Impresión" Style="{StaticResource CaoCardTitleStyle}"/>
                            <TextBlock Text="Cola atascada" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Button Content="Reiniciar cola de impresión" Tag="restart-print-spooler" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar cola de impresión" ToolTipService.ToolTip="Reinicia la cola de impresión (Spooler). Para trabajos atascados que no salen ni cancelando."/>
                    <TextBlock x:Name="PrintStatusText" Style="{StaticResource CaoSectionSubtitleStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Sistema -->
            <Border Style="{StaticResource CaoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource CaoCardIconStyle}" Background="{StaticResource CaoGreenSoftBrush}">
                            <FontIcon Glyph="&#xE930;" FontSize="16" Foreground="{StaticResource CaoGreenSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Sistema" Style="{StaticResource CaoCardTitleStyle}"/>
                            <TextBlock Text="Update y reloj" Style="{StaticResource CaoSectionSubtitleStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource CaoDividerStyle}"/>
                    <Button Content="Reparar Windows Update" Tag="repair-windows-update" Click="OnFixConfirmClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reparar Windows Update" ToolTipService.ToolTip="Renueva SoftwareDistribution y catroot2, reanuda servicios. Para updates atascados con error. Tarda minutos."/>
                    <Button Content="Resincronizar reloj" Tag="resync-system-clock" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Resincronizar reloj del sistema" ToolTipService.ToolTip="Sincroniza el reloj con el servidor horario (w32tm). Corrige desfases de hora."/>
                    <Button Content="Reiniciar Explorador (congelado)" Tag="restart-windows-explorer" Click="OnFixConfirmClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar Explorador de Windows" ToolTipService.ToolTip="Reinicia explorer.exe cuando la barra o el escritorio se congelan. La pantalla parpadea; vuelve solo."/>
                    <Button Content="Recuperar Explorador (sin barra/escritorio)" Tag="recover-windows-explorer" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Recuperar Explorador de Windows" ToolTipService.ToolTip="Trae de vuelta la barra y el escritorio si desaparecieron. No mata nada: solo lanza el shell si falta. Funciona incluso sin el servicio."/>
                    <Button Content="Reiniciar búsqueda Windows" Tag="restart-windows-search" Click="OnFixClick" Style="{StaticResource SolucionarActionButtonStyle}" AutomationProperties.Name="Reiniciar búsqueda de Windows" ToolTipService.ToolTip="Reinicia la búsqueda de Windows (WSearch). Para buscador sin resultados. No cambia la indexación."/>
                    <TextBlock x:Name="SystemStatusText" Style="{StaticResource CaoSectionSubtitleStyle}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
        <Grid x:Name="ApplyOverlay" Background="#99000000" Visibility="{Binding Visibility, ElementName=FixProgressCard}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440" Margin="24">
                <controls:CaoCat x:Name="FixOverlayCat" Width="96" ShowCaption="False" HorizontalAlignment="Center"
                                         AutomationProperties.Name="Mascota de CA-O trabajando"/>
            <Border x:Name="FixProgressCard" Visibility="Collapsed" Style="{StaticResource CaoCardStyle}" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="FixRing" IsActive="False" Width="16" Height="16" Style="{StaticResource CaoProgressRingStyle}"/>
                        <TextBlock x:Name="FixProgressText" Text="" Style="{StaticResource CaoCardTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressBar x:Name="FixProgressBar" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
