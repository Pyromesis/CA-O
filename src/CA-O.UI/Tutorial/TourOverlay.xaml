<UserControl
    x:Class="CAO.UI.Tutorial.TourOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Grid x:Name="Root" Background="Transparent" SizeChanged="OnRootSizeChanged">

        <Canvas x:Name="DimLayer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#B8000000" />
            <Rectangle x:Name="DimRight" Fill="#B8000000" />
            <Rectangle x:Name="DimBottom" Fill="#B8000000" />
            <Rectangle x:Name="DimLeft" Fill="#B8000000" />
            <Border
                x:Name="Spotlight"
                BorderBrush="#00C9B6"
                BorderThickness="2"
                CornerRadius="10" />
        </Canvas>

        <Border
            x:Name="Card"
            Width="400"
            Padding="20,18,20,16"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Background="#F51C2128"
            BorderBrush="#5500C9B6"
            BorderThickness="1"
            CornerRadius="14">

            <StackPanel Spacing="10">

                <Grid>
                    <TextBlock x:Name="StepIndexText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#00C9B6" />
                </Grid>
                <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="100" Value="0" Foreground="#00C9B6" />

                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="White" />

                <TextBlock x:Name="BodyText"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="#E6FFFFFF" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="SkipButton" Content="Saltar" Click="OnSkipClick" />
                    <Button x:Name="BackButton" Content="Atrás" Click="OnBackClick" />
                    <Button x:Name="NextButton" Content="Siguiente" Click="OnNextClick"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
