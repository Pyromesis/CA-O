<Page
    x:Class="CAO.UI.Tutorial.TutorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CAO.UI.Controls">

    <ScrollViewer Padding="{StaticResource CaoPagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="PageContent" Style="{StaticResource CaoPageContainerStyle}">

            <Grid x:Name="PageHeader" Style="{StaticResource CaoPageHeaderGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CaoPageHeaderIconStyle}">
                    <FontIcon Glyph="&#xE82D;" Style="{StaticResource CaoPageHeaderGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Style="{StaticResource CaoPageHeaderStyle}">
                    <TextBlock Text="Tutorial" Style="{StaticResource CaoPageTitleStyle}"/>
                    <TextBlock Text="Todo lo que necesitas saber para usar CA-O de principio a fin. Cada sección tiene su propio tour guiado." Style="{StaticResource CaoSubtitleStyle}"/>
                    <Border Style="{StaticResource CaoHeaderAccentBarStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Recorrido guiado general -->
            <Border Style="{StaticResource CaoCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:CaoCat x:Name="TutorialCat" Width="72" ShowCaption="False" VerticalAlignment="Center"
                                     AutomationProperties.Name="Mascota de CA-O"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Recorrido guiado" Style="{StaticResource CaoCardTitleStyle}"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaoSectionSubtitleStyle}"
                                   Text="Cinco pasos por el flujo principal: Panel, Analizar, Optimizar, Limpieza y Restaurar. Resalta cada botón y explica qué hace."/>
                    </StackPanel>
                    <Button x:Name="StartTourButton" Grid.Column="2"
                            Content="Empezar recorrido guiado"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaoAccentButtonStyle}"
                            Click="OnStartTourClick" />
                </Grid>
            </Border>

            <TextBlock Text="Secciones" Style="{StaticResource CaoSectionHeaderStyle}"/>

            <ItemsRepeater x:Name="ChaptersList">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="340" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CaoCardStyle}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource CaoSignatureGradientBrush}">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CaoCardTitleStyle}"/>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxWidth="260" Style="{StaticResource CaoListItemDetailStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Points}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="5" Height="5" Fill="#00C9B6" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Ir a la sección" Tag="{Binding Route}" Click="OnChapterClick" Style="{StaticResource CaoElevatedButtonStyle}"/>
                                    <Button Content="Ver su tour" Tag="{Binding Route}" Click="OnChapterTourClick" Style="{StaticResource CaoElevatedButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
