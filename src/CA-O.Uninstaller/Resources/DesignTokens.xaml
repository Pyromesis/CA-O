<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CA-O Design System — minimal safe tokens (compilable) -->
    <x:Double x:Key="CaoSpace2">2</x:Double>
    <x:Double x:Key="CaoSpace4">4</x:Double>
    <x:Double x:Key="CaoSpace8">8</x:Double>
    <x:Double x:Key="CaoSpace12">12</x:Double>
    <x:Double x:Key="CaoSpace16">16</x:Double>
    <x:Double x:Key="CaoSpace20">20</x:Double>
    <x:Double x:Key="CaoSpace24">24</x:Double>
    <x:Double x:Key="CaoSpace28">28</x:Double>
    <x:Double x:Key="CaoSpace32">32</x:Double>

    <x:Double x:Key="CaoFontSizeTitleLarge">28</x:Double>
    <x:Double x:Key="CaoFontSizeTitle">20</x:Double>
    <x:Double x:Key="CaoFontSizeSection">16</x:Double>
    <x:Double x:Key="CaoFontSizeBody">14</x:Double>
    <x:Double x:Key="CaoFontSizeCaption">12</x:Double>
    <x:Double x:Key="CaoFontSizeMetric">26</x:Double>

    <Thickness x:Key="CaoCardPadding">16,16,16,16</Thickness>
    <Thickness x:Key="CaoCardPaddingCompact">12,12,12,12</Thickness>
    <Thickness x:Key="CaoPagePadding">28,20,28,20</Thickness>
    <Thickness x:Key="CaoSectionMargin">0,16,0,0</Thickness>

    <Style x:Key="CaoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource CaoCardPadding}"/>
    </Style>

    <Style x:Key="CaoCardElevatedStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CaoMetricCardStyle" TargetType="Border" BasedOn="{StaticResource CaoCardStyle}">
        <Setter Property="Padding" Value="14,14,14,14"/>
        <Setter Property="MinHeight" Value="84"/>
    </Style>

    <Style x:Key="CaoSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeSection}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource CaoSectionMargin}"/>
    </Style>

    <Style x:Key="CaoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeTitleLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CaoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaoFontSizeCaption}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style x:Key="CaoBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3,8,3"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="CaoEmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Semantic color tokens (§56) — no color solo por estética -->
    <SolidColorBrush x:Key="CaoSuccessBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="CaoWarningBrush" Color="#ED6C02"/>
    <SolidColorBrush x:Key="CaoDangerBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="CaoCriticalBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="CaoInfoBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="CaoNeutralBrush" Color="#616161"/>
    <SolidColorBrush x:Key="CaoExperimentalBrush" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="CaoSecurityBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="CaoTextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CaoPrimaryBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="CaoTextSecondaryBrush" Color="#666666"/>

    <!-- Typography scale (§57) -->
    <x:Double x:Key="CaoFontSizeDisplay">32</x:Double>
    <x:Double x:Key="CaoFontSizeH1">24</x:Double>
    <x:Double x:Key="CaoFontSizeH2">18</x:Double>
    <x:Double x:Key="CaoFontSizeH3">14</x:Double>
    <x:Double x:Key="CaoFontSizeMetricLarge">30</x:Double>

    <!-- Spacing centralized 4/8/12/16/24/32/40/48/64 (§58) -->
    <x:Double x:Key="CaoSpace40">40</x:Double>
    <x:Double x:Key="CaoSpace48">48</x:Double>
    <x:Double x:Key="CaoSpace64">64</x:Double>

    <!-- Radius & elevation (§59) -->
    <CornerRadius x:Key="CaoRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CaoRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CaoRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CaoRadiusXLarge">16</CornerRadius>

</ResourceDictionary>
